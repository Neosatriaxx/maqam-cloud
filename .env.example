# ===== Supabase (required) =====
# Project URL: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Server-side keys: use the **service_role** key on the backend (bypasses RLS).
# Public **anon** key is NOT needed by this app because all DB/Storage access is server-side.
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# ===== App config =====
# Password protected again by /api/setup; leave empty to disable admin auth entirely (not recommended).
ADMIN_SETUP_PASSWORD=

# Face match threshold (euclidean distance between 128-d descriptors).
# Lower = stricter. face-api.js convention: 0.6 default, 0.5 strict, 0.45 very strict.
FACE_MATCH_THRESHOLD=0.5
